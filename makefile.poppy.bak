# SNES-BOR makefile
# Build system for Poppy assembler

builddir := build
sourcedir := src
distdir := distribution

romext := sfc
romfile := build/bor.$(romext)

# Poppy assembler
DOTNET_ROOT := /home/chad/.dotnet10
POPPY := DOTNET_ROOT=$(DOTNET_ROOT) PATH="$(DOTNET_ROOT):$$PATH" dotnet /home/chad/poppy/src/Poppy.CLI/bin/Release/net10.0/poppy.dll

.PHONY: all clean rom

all: rom

rom: $(romfile)

$(romfile): src/main.pasm
	$(POPPY) src/main.pasm
	python3 build_rom.py

clean:
	rm -rf $(builddir) $(distdir) src/main.bin src/main.pansy
	@echo "Build artifacts cleaned"
