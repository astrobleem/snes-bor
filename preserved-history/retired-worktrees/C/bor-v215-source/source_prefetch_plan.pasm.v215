    lsr a
    lsr a
    sta.l SourcePrefetch_Plan+8
    lda.l SourceInput_Producer
    cmp.l SourcePrefetch_Plan+12
    beq SourcePrefetch_PlanOnly__guard55
    brl SourcePrefetch_PlanOnly__no
SourcePrefetch_PlanOnly__guard55:
.a16
.i16
    lda.l $434E7C
    cmp.l SourcePrefetch_Plan+30
    beq SourcePrefetch_PlanOnly__snapshot_still_current
    brl SourcePrefetch_PlanOnly__no
SourcePrefetch_PlanOnly__snapshot_still_current:
.a16
.i16
    pld
    plb
    ply
    plx
    pla
    plp
    sec
    rtl
SourcePrefetch_PlanOnly__no:
.a16
.i16
    pld
    plb
    ply
    plx
    pla
    plp
    clc
    rtl
SourcePrefetch_PlanEnd:
.a16
.i16

; UNHOOKED submission API. A=hot index. C=one job enqueued; private status1
; means existing data,2 means new job,0 means no admission. Not called by game.
; No staging payload copy, MSU access, actor/Ready/input/world/publication write.
; The ORIGINAL physical four-row certificate is the only A6->A7 authority.
SourcePrefetch_TryOne:
.a16
.i16
    php
    rep #$30
    cld
    pha
    phx
    phy
    phb
    phd
    lda.l $7E46DE
    bne SourcePrefetch_TryOne__no_near
    jsr SourceNpc_Scope
    bcc SourcePrefetch_TryOne__no_near
    lda #0
    sta.l SourcePrefetch_Plan+20
    lda 8,s
    jsl SourcePrefetch_PlanOnly
    bcs SourcePrefetch_TryOne__plan
SourcePrefetch_TryOne__no_near:
.a16
.i16
    brl SourcePrefetch_TryOne__no
SourcePrefetch_TryOne__plan:
.a16
.i16
    lda.l Nmi_FrameBusy
    and #$00FF
    cmp #2
    bcs SourcePrefetch_TryOne__no_near
    sta.l SourcePrefetch_Plan+32
    sep #$20
.a8
    lda #1
    sta.l Nmi_FrameBusy
    lda #0
    pha
    plb
    rep #$30
.a16
.i16
    lda.l SourceInput_Producer
    cmp.l SourcePrefetch_Plan+12
    bne SourcePrefetch_TryOne__abort_near
    lda.l SourceInput_Overflows
    bne SourcePrefetch_TryOne__abort_near
    lda.l $434E7C
    cmp.l SourcePrefetch_Plan+30
    bne SourcePrefetch_TryOne__abort_near
    lda.l SourcePrefetch_PhysicalPending
    bne SourcePrefetch_TryOne__abort_near
    lda.l DmaQueue_BudgetTotal
    cmp #1025
    bcs SourcePrefetch_TryOne__abort_near
    lda.l SourcePrefetch_Plan+6
    tax
    lda.l SourceVisual_BlockCache+2,x
    bne SourcePrefetch_TryOne__abort_near
    lda.l SourceVisual_BlockCache+4,x
    and #$00FF
    bne SourcePrefetch_TryOne__abort_near
    lda.l SVActor_HeldBlocks,x
    ora.l SVActor_OldBlocks,x
    and #$00FF
    beq SourcePrefetch_TryOne__save
SourcePrefetch_TryOne__abort_near:
.a16
.i16
    brl SourcePrefetch_TryOne__restore_busy_no
SourcePrefetch_TryOne__save:
.a16
.i16
    lda.l SourceVisual_BlockCache,x
    sta.l SourcePrefetch_Plan+40
    lda.l SourceVisual_BlockCache+2,x
    sta.l SourcePrefetch_Plan+42
    lda.l SourceVisual_BlockCache+4,x
    sta.l SourcePrefetch_Plan+44
    lda.l SourceVisual_BlockCache+6,x
    sta.l SourcePrefetch_Plan+46
    ldx #0
SourcePrefetch_TryOne__save_request:
.a16
.i16
    lda.l DmaRequest_SourceAddrLow,x
    sta.l SourcePrefetch_Plan+48,x
    inx
    inx
    cpx #8
    bcc SourcePrefetch_TryOne__save_request
    lda.l SourcePrefetch_Plan+6
    tax
    lda #0
    sta.l SourceVisual_BucketMagic
    sta.l SourcePending_KnownClear
    lda.l SourcePrefetch_Plan
    sta.l SourceVisual_BlockCache,x
    lda #1
    sta.l SourceVisual_BlockCache+2,x
    sep #$20
.a8
    lda #0
    sta.l SourceVisual_BlockCache+4,x
    lda #4
    sta.l SourceVisual_BlockCache+5,x
    lda #2
    sta.l SourceVisual_BlockCache+6,x
    lda #$A6
    sta.l SourceVisual_BlockCache+7,x
    lda.l SourcePrefetch_Plan+2
    sta.l DmaRequest_SourceBank
    lda #DMA_TYPE_SOURCE_BLOCK
    sta.l DmaRequest_TypeFlags
    rep #$30
.a16
.i16
    lda.l SourcePrefetch_Plan+4
    sta.l DmaRequest_SourceAddrLow
    lda #256
    sta.l DmaRequest_Length
    ; Slot->16x32 OBJ origin, matching the original allocator exactly.
    lda.l SourcePrefetch_Plan+8
    and #7
    asl a
    sta.l SourcePrefetch_Plan+34
    lda.l SourcePrefetch_Plan+8
    and #24
    asl a
    asl a
    asl a
    ora.l SourcePrefetch_Plan+34
    sta.l SourcePrefetch_Plan+34
    lda.l SourcePrefetch_Plan+8
    and #32
    asl a
    asl a
    asl a
    ora.l SourcePrefetch_Plan+34
    asl a
    asl a
    asl a
    asl a
    asl a
    clc
    adc #$8000
    sta.l DmaRequest_TargetAddr
    jsl Core_Dma_Enqueue_Long
    bcc SourcePrefetch_TryOne__rollback
    ; Enqueue returns its real chosen queue-byte X. Owner0 is a private
    ; producer, never the P1 completed/retiring owner bits64/128.
    txa
    lsr a
    lsr a
    lsr a
    tax
    sep #$20
.a8
    lda #0
    sta.l DmaQueue_Owner,x
    rep #$30
.a16
.i16
    lda.l SourcePrefetch_PhysicalPending
    inc a
    sta.l SourcePrefetch_PhysicalPending
    lda #2
    sta.l SourcePrefetch_Plan+20
    bra SourcePrefetch_TryOne__restore_request
SourcePrefetch_TryOne__rollback:
.a16
.i16
    lda.l SourcePrefetch_Plan+6
    tax
    lda.l SourcePrefetch_Plan+40
    sta.l SourceVisual_BlockCache,x
    lda.l SourcePrefetch_Plan+42
    sta.l SourceVisual_BlockCache+2,x
    lda.l SourcePrefetch_Plan+44
    sta.l SourceVisual_BlockCache+4,x
    lda.l SourcePrefetch_Plan+46
    sta.l SourceVisual_BlockCache+6,x
SourcePrefetch_TryOne__restore_request:
.a16
.i16
    ldx #0
SourcePrefetch_TryOne__request_word:
.a16
.i16
    lda.l SourcePrefetch_Plan+48,x
    sta.l DmaRequest_SourceAddrLow,x
    inx
    inx
    cpx #8
    bcc SourcePrefetch_TryOne__request_word
    sep #$20
.a8
    lda.l SourcePrefetch_Plan+32
    sta.l Nmi_FrameBusy
    rep #$30
.a16
.i16
    lda.l SourcePrefetch_Plan+20
    cmp #2
    bne SourcePrefetch_TryOne__no
    pld
    plb
    ply
    plx
    pla
    plp
    sec
    rtl
SourcePrefetch_TryOne__restore_busy_no:
.a16
.i16
    sep #$20
.a8
    lda.l SourcePrefetch_Plan+32
    sta.l Nmi_FrameBusy
    rep #$30
.a16
.i16
SourcePrefetch_TryOne__no:
.a16
.i16
    pld
    plb
    ply
    plx
    pla
    plp
    clc
    rtl
SourcePrefetch_SubmitEnd:
.a16
.i16

; Optional immutable attack tiles: one admission attempt per host field,
; after the existing first-NPC service. No palette or actor publication.
SourcePrefetch_Cursor = $7E46E8
SourcePrefetch_LastField = $7E46EA
SourcePrefetch_Submitted = $7E46EC
SourcePrefetch_Init:
.a16
.i16
    pha
    lda #0
    sta.l SourcePrefetch_PhysicalPending
    sta.l SourcePrefetch_Submitted
    lda #0 ; warm first attack0 before later attack frames
    sta.l SourcePrefetch_Cursor
    lda #$FFFF
    sta.l SourcePrefetch_LastField
    pla
    rtl
SourcePrefetch_DuringWait:
.a16
.i16
    php
    rep #$30
    cld
    pha
    phx
    phy
    phb
    phd
    lda.l $7E46DE
    bne SourcePrefetch_DuringWait__done
    jsr SourceNpc_Scope
    bcc SourcePrefetch_DuringWait__done
    lda.l Nmi_FrameCounter
    cmp.l SourcePrefetch_LastField
    beq SourcePrefetch_DuringWait__done
    sta.l SourcePrefetch_LastField
    lda #0
    sta.l SourcePrefetch_Plan+20
    lda.l SourcePrefetch_Cursor
    cmp #22
    bcc SourcePrefetch_DuringWait__cursor
    lda #10
SourcePrefetch_DuringWait__cursor:
.a16
.i16
    jsl SourcePrefetch_TryOne
    bcc SourcePrefetch_DuringWait__status
    lda.l SourcePrefetch_Submitted
    inc a
    sta.l SourcePrefetch_Submitted
SourcePrefetch_DuringWait__status:
.a16
.i16
    lda.l SourcePrefetch_Plan+20
    beq SourcePrefetch_DuringWait__done
    lda.l SourcePrefetch_Cursor
    inc a
    cmp #22
    bcc SourcePrefetch_DuringWait__save_cursor
    lda #0
SourcePrefetch_DuringWait__save_cursor:
.a16
.i16
    sta.l SourcePrefetch_Cursor
SourcePrefetch_DuringWait__done:
.a16
.i16
    pld
    plb
    ply
    plx
    pla
    plp
    rtl
SourcePrefetch_WaitEnd:
.a16
.i16
