SourcePacket_LongBranch37:
.a16
.i16
    brl SourcePacket_Refresh__done
SourcePacket_Refresh__guard10:
.a16
.i16
    lda.l $434E7E
    cmp #$4D50
    bne SourcePacket_LongBranch38
