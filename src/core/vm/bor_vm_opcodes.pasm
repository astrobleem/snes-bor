; BOR/OpenBOR Build 4086-era script opcode ABI
; Values are contractual. OPCODE_END is a sentinel, not a handler.
; Poppy does not provide a C preprocessor include model; concatenate this file
; before bor_vm_core.pasm or generate equivalent constants in the final build.

BOR_VT_EMPTY=$00
BOR_VT_INTEGER=$01
BOR_VT_DECIMAL=$02
BOR_VT_PTR=$05
BOR_VT_STR=$06

BOR_OP_CONSTSTR=$00
BOR_OP_CONSTDBL=$01
BOR_OP_CONSTINT=$02
BOR_OP_LOAD=$03
BOR_OP_SAVE=$04
BOR_OP_INC=$05
BOR_OP_DEC=$06
BOR_OP_FIELD=$07
BOR_OP_CALL=$08
BOR_OP_POS=$09
BOR_OP_NEG=$0A
BOR_OP_NOT=$0B
BOR_OP_MUL=$0C
BOR_OP_DIV=$0D
BOR_OP_MOD=$0E
BOR_OP_ERR=$0F
BOR_OP_ADD=$10
BOR_OP_SUB=$11
BOR_OP_SHL=$12
BOR_OP_SHR=$13
BOR_OP_JUMP=$14
BOR_OP_PJUMP=$15
BOR_OP_GE=$16
BOR_OP_LE=$17
BOR_OP_LT=$18
BOR_OP_GT=$19
BOR_OP_EQ=$1A
BOR_OP_NE=$1B
BOR_OP_OR=$1C
BOR_OP_AND=$1D
BOR_OP_BIT_OR=$1E
BOR_OP_XOR=$1F
BOR_OP_BIT_AND=$20
BOR_OP_NOOP=$21
BOR_OP_PUSH=$22
BOR_OP_POP=$23
BOR_OP_BRANCH_FALSE=$24
BOR_OP_BRANCH_TRUE=$25
BOR_OP_BRANCH_EQUAL=$26
BOR_OP_DATA=$27
BOR_OP_PARAM=$28
BOR_OP_IMMEDIATE=$29
BOR_OP_DEFERRED=$2A
BOR_OP_RET=$2B
BOR_OP_CHECKARG=$2C
BOR_OP_CLEAN=$2D
BOR_OP_JUMPR=$2E
BOR_OP_FUNCDECL=$2F

BOR_OPCODE_END=$30
BOR_OPCODE_COUNT=$30
