+; TAD-owned receive endpoint for one 144-byte BRR frame. The host sends one
+; submit row whose APUIO3 value is STREAM_HDMA_MARKER, then 72 mode-4 rows.
+; APUIO0 is reserved for command/ack traffic. Each payload row publishes two
+; BRR bytes on APUIO1/2, then commits the row with a low-5-bit token on APUIO3.
+.proc cmd__stream_receive_frame
+    ; Host supplies the current physical ring destination in PARAMETER_0/1
+    ; before starting the HDMA payload.  This keeps slot selection explicit
+    ; and prevents the producer from overwriting one fixed buffer forever.
+    mov A, DriverIO__PARAMETER_0_PORT
+    mov zpTmp, A
+    ; Bit 7 suppresses KON for prefill; bit 6 requests a new playback epoch.
+    ; Ring destination high bytes are below $40. Save both flags until the
+    ; payload is received; neither flag is part of the physical address.
+    mov A, DriverIO__PARAMETER_1_PORT
+    mov zpTmp2, A
+    and A, #$c0
+    mov lagDetector, A
+    mov A, zpTmp2
+    and A, #$3f
+    mov zpTmp2, A
+    ; Save the command shadow so the submit row can serve as a start latch.
+    mov A, previousCommand
+    push A
+    ; Reuse the lag byte as bounded receive-local scratch.  The old value is
+    ; restored before returning, so this does not alter TAD state.
+    mov A, lagDetector
+    push A
+ReceiveStreamFrame__wait_submit:
+    ; APUIO0 remains the accepted stream command for the entire transfer.
+    ; The host clears APUIO3 before dispatch, then the HDMA submit row
+    ; publishes STREAM_HDMA_MARKER. This prevents a payload dummy byte from
+    ; being interpreted as an ordinary TAD command.
+    mov A, DriverIO__SWITCH_TO_LOADER_PORT
+    cmp A, #STREAM_HDMA_MARKER
+    bne ReceiveStreamFrame__wait_submit
+    mov A, #$ff
+    mov previousCommand, A
+    mov A, #$00
+    mov lagDetector, A
+    mov Y, #0
+    mov X, #72
+ReceiveStreamFrame__payload:
+ReceiveStreamFrame__wait_token:
+    ; APUIO3 is written last by the mode-4 producer row. Do not sample the
+    ; data lanes until the expected commit token is visible.
+    mov A, DriverIO__SWITCH_TO_LOADER_PORT
+    cmp A, lagDetector
+    bne ReceiveStreamFrame__wait_token
+    mov A, DriverIO__PARAMETER_0_PORT
+    mov [zpTmp] + Y, A
+    inc Y
+    mov A, DriverIO__PARAMETER_1_PORT
+    mov [zpTmp] + Y, A
+    inc Y
+    mov A, lagDetector
+    inc A
+    and A, #$1f
+    mov lagDetector, A
+    dec X
+    beq ReceiveStreamFrame__payload_done
+    bra ReceiveStreamFrame__payload
+ReceiveStreamFrame__payload_done:
+
+    ; Restore the destination-mode byte before using it for first-start logic.
+    pop A
+    mov lagDetector, A
+    ; Transport-only prefill transactions populate the ring but must not
+    ; claim voice 0.  The normal-mode transaction performs the one-time
+    ; directory rewrite and KON after the ring is ready.
+    mov A, lagDetector
+    and A, #$80
+    bne StreamReceiveFrame__not_first
+    mov A, lagDetector
+    and A, #$40
+    bne StreamReceiveFrame__first_start
+    ; The generated stream directory entry is not the ring pointer before
+    ; the first normal-mode transaction. Use that durable DSP state to gate
+    ; the one-time KON instead of depending on the command dispatcher shadow,
+    ; which is restored by the surrounding TAD protocol.
+    mov A, brrDirectory+133
+    cmp A, #hibyte(STREAM_RING_ADDR)
+    bne StreamReceiveFrame__first_start
+    mov A, brrDirectory+132
+    cmp A, #lobyte(STREAM_RING_ADDR)
+    beq StreamReceiveFrame__not_first
+StreamReceiveFrame__first_start:
+    mov A, #lobyte(STREAM_RING_ADDR)
+    mov brrDirectory+132, A
+    mov A, #hibyte(STREAM_RING_ADDR)
+    mov brrDirectory+133, A
+    ; Explicit stream ownership of physical DSP voice 0, only at first start.
+    mov A, #$04
+    mov Y, #33
+    movw DSPADDR, YA
+    ; MOTU source-stream experiment: configure the reserved voice's envelope.
+    ; Its ordinary TAD channel updates are excluded, so power-on DSP contents
+    ; cannot supply ADSR/gain defaults. Use the authored non-loop gain policy.
+    mov A, #$05
+    mov Y, #$00
+    movw DSPADDR, YA
+    mov A, #$07
+    mov Y, #$7f
+    movw DSPADDR, YA
+    mov A, #$00
+    mov Y, #$7f
+    movw DSPADDR, YA
+    inc A
+    mov Y, #$7f
+    movw DSPADDR, YA
+    inc A
+    mov Y, #$83
+    movw DSPADDR, YA
+    inc A
+    mov Y, #$05
+    movw DSPADDR, YA
+    mov A, #DSP_KON
+    mov Y, #$01
+    movw DSPADDR, YA
+StreamReceiveFrame__not_first:
+    mov A, #lobyte(STREAM_RING_ADDR)
+    mov brrDirectory+134, A
+    mov A, #hibyte(STREAM_RING_ADDR)
+    mov brrDirectory+135, A
+
+StreamReceiveFrame__restore_marker:
+    pop A
+    mov previousCommand, A
+
+StreamReceiveFrame__ack:
+    ; The outer IO dispatcher owns the authoritative command acknowledgement.
+    ret
+.endproc
+
 
 
